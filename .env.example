PROJECT_NAME=rm_auth_tenant

# --- App ---
APP_PORT=8001
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-only-not-for-production
DJANGO_ALLOWED_HOSTS=*

# --- Database ---
# IMPORTANT: must be a DIFFERENT database than rm_auth_project's own .env
# (which uses POSTGRES_DB=appdb). rm_auth and rm_auth_tenant are two separate
# Django projects/migration histories -- pointing both at the same physical
# database produces InconsistentMigrationHistory errors (see the "Tier B
# Implementation Plan" doc's correction note for the incident this caused).
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=apppassword
POSTGRES_PORT=5432
POSTGRES_HOST=db

# --- rm_auth_tenant ---
RM_AUTH_DEFAULT_ALGORITHM=HS256
RM_AUTH_HS256_SECRET=dev-only-hs256-secret-change-me
RM_AUTH_ACCESS_TTL=900
RM_AUTH_REFRESH_TTL=604800
RM_AUTH_ENFORCER_TTL=300
RM_AUTH_DEFAULT_TENANT_ID=default
RM_AUTH_DEFAULT_PERSONA_NAME=Default
RM_AUTH_PASSWORD_MIN_LENGTH=8

# --- Signup email verification (community edition) ---
# Keep false for local/dev. Set to true when going to production so new
# signups must verify their email before they can log in.
RM_AUTH_SIGNUP_EMAIL_VERIFICATION_ENABLED=false
RM_AUTH_EMAIL_VERIFICATION_TTL=259200
RM_AUTH_EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email?token={token}

# --- Outbound email ---
# Console backend (default) just prints emails to stdout -- fine for dev.
# Switch to django.core.mail.backends.smtp.EmailBackend + the EMAIL_HOST_*
# vars below for production.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_HOST=localhost
DJANGO_EMAIL_PORT=25
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=false
DJANGO_DEFAULT_FROM_EMAIL=no-reply@rm-auth-tenant.local
