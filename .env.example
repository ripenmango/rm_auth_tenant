PROJECT_NAME=rm_auth_tenant

# --- App ---
APP_PORT=8001
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-only-not-for-production
DJANGO_ALLOWED_HOSTS=*

# --- Database ---
# IMPORTANT: must be a DIFFERENT database than rm_auth_project's own .env
# (which uses POSTGRES_DB=appdb). rm_auth and rm_auth_tenant are two separate
# Django projects/migration histories -- pointing both at the same physical
# database produces InconsistentMigrationHistory errors (see the "Tier B
# Implementation Plan" doc's correction note for the incident this caused).
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=apppassword
POSTGRES_PORT=5432
POSTGRES_HOST=db

# --- rm_auth_tenant ---
RM_AUTH_DEFAULT_ALGORITHM=HS256
RM_AUTH_HS256_SECRET=dev-only-hs256-secret-change-me
RM_AUTH_ACCESS_TTL=900
RM_AUTH_REFRESH_TTL=604800
RM_AUTH_ENFORCER_TTL=300
RM_AUTH_DEFAULT_TENANT_ID=default
RM_AUTH_DEFAULT_PERSONA_NAME=Default
